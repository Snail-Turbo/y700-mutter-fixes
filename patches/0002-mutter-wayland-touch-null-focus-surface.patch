Description: wayland/touch: Do not crash on an empty focus surface
 Carry the local guard that prevents a NULL focus_surface dereference
 when a touch sequence is used to resize a GTK window.
Origin: local
--- a/src/wayland/meta-wayland-touch.c
+++ b/src/wayland/meta-wayland-touch.c
@@ -656,6 +656,9 @@
 {
   MetaWaylandSurface *subsurface;
 
+  if (!touch_info->focus_surface)
+    return FALSE;
+
   if (touch_info->focus_surface->surface == surface)
     return TRUE;
 
